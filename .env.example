# ==============================================================================
# CONFIGURATION FOR DOCKER COMPOSE & DUAL MODE (LOCAL / DOCKER)
# ==============================================================================

# Database Settings
MYSQL_DATABASE=englishlearning_db
MYSQL_ROOT_PASSWORD=root
# Port mapping on host (3307 để tránh xung đột với MySQL local 3306)
MYSQL_HOST_PORT=3307

# Services Host Ports
BACKEND_PORT=8080
FRONTEND_PORT=3000
PHONETICS_PORT=8000

