@startuml Hinh_1_8_So_do_hoat_dong_UC_AI_01_Luyen_phat_am_Shadowing_Fallback_3_tang
skinparam ConditionStyle diamond
title Hình 1.8: Sơ đồ hoạt động UC Luyện phát âm Shadowing & AI Fallback 3 tầng (UC-AI-01)
skinparam dpi 150
skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam titleFontSize 15
skinparam titleFontStyle bold
skinparam roundcorner 6
skinparam padding 4
skinparam ConditionEndStyle hline

start
:Học viên thu âm câu mẫu tại Shadowing Studio (WAV 16kHz);
:Gửi audio tới POST /api/v1/ai/speaking/shadowing-evaluate;

partition "Tầng 1: Python Acoustic Engine (FastAPI :8000)" {
    :VAD lọc khoảng lặng & kiểm tra nhiễu SNR;
    :Wav2Vec2 CTC căn chỉnh mốc thời gian âm vị IPA;
    :Praat đo Formant F1/F2 & tính điểm GOP (< 1.0s);
}

if (Python phản hồi thành công?) then (Có)
    :EvaluatedBy = "PYTHON_ACOUSTIC_ENGINE";
else (Lỗi kết nối / Timeout)
    partition "Tầng 2: Groq Whisper STT + Google Gemini 2.5 Flash" {
        :Groq Whisper-large-v3 bóc băng giọng nói;
        :Gemini 2.5 Flash đối chiếu câu mẫu & nhận xét lỗi;
    }
    if (Gemini thành công?) then (Có)
        :EvaluatedBy = "GEMINI_AI_FALLBACK";
    else (Lỗi HTTP 429 Quota / Mạng)
        partition "Tầng 3: Groq LLaMA 3.3 70B (Dự phòng khẩn cấp)" {
            :Gửi prompt sang llama-3.3-70b-versatile (JSON Mode);
            :EvaluatedBy = "GROQ_AI_FALLBACK";
        }
    endif
endif

:SpeakingAiCoachingService sinh AiCoachingAdvice (Groq / Gemini);
:Lưu ai_evaluations & cập nhật student_skill_profiles (MySQL);
:Đẩy WebSocket STOMP (/topic/student/{userId}/evaluation);
:Frontend hiển thị Review Mode (Tô màu từ, IPA, Formant & AiCoachingCard);
stop
@enduml
