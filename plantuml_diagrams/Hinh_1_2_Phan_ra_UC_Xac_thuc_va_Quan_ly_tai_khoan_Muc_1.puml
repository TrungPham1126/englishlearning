@startuml Hinh_1_2_Phan_ra_UC_Xac_thuc_va_Quan_ly_tai_khoan_Muc_1
title Hình 1.2: Sơ đồ phân rã Use Case Xác thực và Quản lý tài khoản - Mức 1
left to right direction
skinparam dpi 150
skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam titleFontSize 15
skinparam titleFontStyle bold
skinparam roundcorner 6
skinparam padding 4
skinparam packageStyle rectangle
skinparam nodesep 10
skinparam ranksep 12

actor "Người dùng\n(User)" as User

rectangle "Phân hệ Xác thực và Quản lý tài khoản (Authentication & RBAC)" {
    usecase "Đăng nhập hệ thống\n(Email & Password)" as UC_LOGIN
    usecase "Làm mới phiên ngầm định\n(Silent Token Refresh)" as UC_REFRESH
    usecase "Đăng xuất & Thu hồi Token\n(Revoke RefreshToken)" as UC_LOGOUT
    usecase "Cập nhật hồ sơ, Ảnh đại diện\n& Đổi mật khẩu" as UC_PROFILE

    usecase "Xác thực BCrypt &\nCấp cặp JWT Token" as UC_BCRYPT
    usecase "Bắt lỗi HTTP 401 &\nCấp lại Access Token" as UC_INTERCEPT
    usecase "Thu hồi Refresh Token\ntrong CSDL & xóa Cookie" as UC_REVOKE
}

actor "Axios Interceptor\n(Client Engine)" as Axios <<Service>>

User --> UC_LOGIN
User --> UC_REFRESH
User --> UC_LOGOUT
User --> UC_PROFILE

UC_LOGIN ..> UC_BCRYPT : <<includes>>
UC_REFRESH ..> UC_INTERCEPT : <<includes>>
UC_LOGOUT ..> UC_REVOKE : <<includes>>
UC_INTERCEPT --> Axios
@enduml
