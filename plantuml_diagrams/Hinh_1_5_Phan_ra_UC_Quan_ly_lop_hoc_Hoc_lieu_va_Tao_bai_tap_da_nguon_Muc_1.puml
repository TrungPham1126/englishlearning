@startuml Hinh_1_5_Phan_ra_UC_Quan_ly_lop_hoc_Hoc_lieu_va_Tao_bai_tap_da_nguon_Muc_1
title Hình 1.5: Phân rã UC Quản lý lớp, Học liệu & Tạo bài tập đa nguồn (Teacher) - Mức 1
left to right direction
skinparam dpi 150
skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam titleFontSize 15
skinparam titleFontStyle bold
skinparam roundcorner 6
skinparam padding 4
skinparam packageStyle rectangle
skinparam nodesep 10
skinparam ranksep 12

actor "Giảng viên\n(Teacher)" as Teacher

rectangle "Phân hệ Quản lý lớp học, Học liệu & Bài tập (Giảng viên)" {
    usecase "Quản lý lớp học, Học viên\n& Bài giảng" as UC_CLASS
    usecase "Tải lên Video bài giảng\n(Đẩy vào RabbitMQ)" as UC_UPLOAD
    usecase "Lập & Mở khóa Lộ trình\n(DailyStudyPlan)" as UC_UNLOCK
    usecase "Tạo bài tập & Đề thi đa nguồn\n(AI / Excel / Thủ công)" as UC_CREATE
    usecase "Chấm bài thi tự luận &\nGửi thông báo lớp" as UC_GRADE

    usecase "Quản lý Tài liệu PDF/DOC,\nTừ vựng & Ngữ pháp" as UC_DOC
    usecase "Chuyển mã Video HLS\n(Worker FFmpeg)" as UC_HLS
    usecase "Sinh câu hỏi / Đề thi CEFR\n(Gemini 2.5 / Groq)" as UC_GEN_AI
    usecase "Tổng hợp âm thanh đọc\n(Kokoro-82M TTS)" as UC_TTS
    usecase "Xem gợi ý điểm AI &\nNhận xét sư phạm" as UC_AI_GRADE
}

actor "Cloudflare R2\nStorage" as R2 <<Service>>
actor "Kokoro TTS (:8000)\n& Cloud AI" as GeminiTTS <<Service>>

Teacher --> UC_CLASS
Teacher --> UC_UPLOAD
Teacher --> UC_UNLOCK
Teacher --> UC_CREATE
Teacher --> UC_GRADE

UC_CLASS ..> UC_DOC : <<includes>>
UC_UPLOAD ..> UC_HLS : <<includes>>
UC_CREATE ..> UC_UNLOCK : <<includes>>
UC_CREATE ..> UC_GEN_AI : <<includes>>
UC_CREATE ..> UC_TTS : <<includes>>
UC_GRADE ..> UC_AI_GRADE : <<includes>>

UC_DOC --> R2
UC_HLS --> R2
UC_GEN_AI --> GeminiTTS
UC_TTS --> GeminiTTS
UC_TTS --> R2
@enduml
