@startuml Hinh_1_3_Phan_ra_UC_Hoc_tap_va_Luyen_thi_theo_lo_trinh_ngay_Muc_1
title Hình 1.3: Sơ đồ phân rã Use Case Học tập và Luyện thi theo lộ trình ngày - Mức 1
left to right direction
skinparam dpi 150
skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam titleFontSize 15
skinparam titleFontStyle bold
skinparam roundcorner 6
skinparam padding 4
skinparam packageStyle rectangle
skinparam nodesep 10
skinparam ranksep 12

actor "Học viên\n(Student)" as Student

rectangle "Phân hệ Học tập và Luyện thi theo lộ trình ngày (Student)" {
    usecase "Xem Lộ trình học ngày\n(DailyStudyPlan)" as UC_PLAN
    usecase "Xem Video bài giảng\n(Phát luồng thích ứng HLS)" as UC_VIDEO
    usecase "Học Từ vựng IPA, Ngữ pháp\n& Tài liệu bài giảng" as UC_LESSON_RES
    usecase "Làm bài tập & Thi CBT\n(Đa dạng bài & Tính giờ)" as UC_CBT

    usecase "Mở khóa theo lịch ngày /\nGiảng viên & theo dõi Streak" as UC_UNLOCK
    usecase "Phát luồng .m3u8/.ts &\nlưu tiến độ xem video" as UC_HLS
    usecase "Tra cứu Từ vựng, Ngữ pháp\n& tải tài liệu PDF/DOC" as UC_DOCS
    usecase "Lưu nháp LocalStorage, giám sát\nchuyển tab & tự nộp khi hết giờ" as UC_DRAFT
}

actor "Cloudflare R2\nStorage" as R2 <<Service>>

Student --> UC_PLAN
Student --> UC_VIDEO
Student --> UC_LESSON_RES
Student --> UC_CBT

UC_PLAN ..> UC_UNLOCK : <<includes>>
UC_VIDEO ..> UC_HLS : <<includes>>
UC_LESSON_RES ..> UC_DOCS : <<includes>>
UC_CBT ..> UC_DRAFT : <<includes>>
UC_HLS --> R2
UC_DOCS --> R2
@enduml
