@startuml Hinh_2_3_Luong_xu_ly_du_lieu_va_3_Tier_AI_Fallback
skinparam ConditionStyle diamond
title Hình 2.3: Luồng xử lý dữ liệu và cơ chế dự phòng đa tầng (3-Tier AI Fallback)
skinparam dpi 150
skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam titleFontSize 15
skinparam titleFontStyle bold
skinparam roundcorner 6
skinparam padding 4
skinparam ConditionEndStyle hline
start
:Client gửi Audio WAV (16kHz) & Câu mẫu tham chiếu;
:AiLabController tiếp nhận tại /api/v1/ai/speaking/shadowing-evaluate;

partition "Tầng 1: Python Phonetics Microservice (:8000)" {
    :VAD lọc khoảng lặng & kiểm tra nhiễu SNR;
    :Wav2Vec2 CTC gióng mốc thời gian âm vị IPA;
    :Praat tính Formant F1/F2 & điểm GOP phụ âm (< 1.0s);
}

if (Python phản hồi thành công?) then (Có)
    :Engine = "PYTHON_ACOUSTIC_ENGINE";
else (Lỗi kết nối / Timeout)
    partition "Tầng 2: Groq Whisper + Google Gemini 2.5 Flash" {
        :Groq Whisper-large-v3 bóc băng văn bản STT;
        :Gemini 2.5 Flash chấm ngữ âm & sinh nhận xét;
    }
    if (Gemini thành công?) then (Có)
        :Engine = "GEMINI_AI_FALLBACK";
    else (Lỗi HTTP 429 Quota / Mạng)
        partition "Tầng 3: Groq LLaMA 3.3 70B (Dự phòng khẩn cấp)" {
            :Groq llama-3.3-70b-versatile (JSON Mode);
            :Engine = "GROQ_AI_FALLBACK";
        }
    endif
endif

:SpeakingAiCoachingService sinh AiCoachingAdvice (Groq -> fallback Gemini);
:Lưu ai_evaluations & cập nhật student_skill_profiles (MySQL);
:Đẩy thông báo WebSocket (/ws) & hiển thị Review Mode & AiCoachingCard;
stop
@enduml
